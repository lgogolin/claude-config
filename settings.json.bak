{
  "cleanupPeriodDays": 7,
  "includeCoAuthoredBy": false,
  "disabledMcpjsonServers": [
    "grafana"
  ],
  "skillOverrides": {
    "api-design": "off",
    "architecture-decision-records": "off",
    "clickhouse-io": "off",
    "context-budget": "off",
    "database-migrations": "off",
    "design-system": "off",
    "docs-update": "off",
    "e2e-testing": "off",
    "frontend-patterns": "off",
    "go-spec-reviewer": "off",
    "postgres-patterns": "off",
    "security-scan": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/strategic-compact/suggest-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/continuous-learning/evaluate-session.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "victoriametrics-tools": {
      "source": {
        "source": "github",
        "repo": "VictoriaMetrics/skills"
      }
    },
    "patternfly-ai-helpers": {
      "source": {
        "source": "github",
        "repo": "patternfly/ai-helpers"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "theme": "dark"
}
